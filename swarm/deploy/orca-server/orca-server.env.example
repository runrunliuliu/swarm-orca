# orca-server.env — host-specific values for swarm/deploy/orca-server/run
#
# Install as /etc/orca-server.env, owner root, mode 0600. This file is the ONLY place the
# deployment's addresses, account and paths live; the run script itself is in git and carries no
# host values. Copy this example, replace everything in angle brackets.
#
# Why an env file instead of a generated run script: the run script twice drifted from what the
# repository said (a promotion edited it in place, and an older copy silently reverted it). Values
# change per host; the logic should not, and git should be able to tell whether the installed
# script is the reviewed one.

# Account the runtime runs as. The run script drops privileges to it.
ORCAD_SERVICE_USER=<service-user>

# Its home directory; `cd` before exec matches the service's historical working directory.
ORCAD_SERVICE_HOME=/home/<service-user>

# Where `orca` and friends are found by children. Keep ~/.local/bin first so bare `orca` resolves
# through the version pointer instead of a distro package.
ORCAD_SERVICE_PATH=/home/<service-user>/.local/bin:/usr/local/bin:/usr/bin:/bin

# Runtime identity and configuration roots.
ORCAD_XDG_CONFIG_HOME=/home/<service-user>/.local/state/orca-server/config
ORCA_USER_DATA=/home/<service-user>/.local/state/orca-server/config/orca
# Optional: `gh` config the runtime uses for hosted review lookups. Leave unset to inherit.
ORCAD_GH_CONFIG_DIR=/home/<service-user>/.config/gh
ORCA_VERSION=1.4.219
ORCA_APP_VERSION=1.4.219

# Bind address and the endpoint advertised to clients. Loopback plus an SSH forward unless the host
# is meant to be reachable; the run script refuses to start when a global IPv4 address exists and
# ORCAD_REFUSE_IPV4 is 1.
ORCAD_BIND=127.0.0.1
ORCAD_PORT=<port>
ORCAD_PAIRING_ADDRESS=ws://<advertised-host>:<port>
ORCAD_REFUSE_IPV4=1

# The version pointer this host serves (see swarm/docs/design/cli-version-pointer.md).
ORCA_BUILD_POINTER_PATH=/opt/orca/current

# Bootstrap only: used when the pointer does not exist yet (a fresh install has no serving build to
# publish it). Once the pointer exists it takes precedence, so leave this as the artifact you want
# a pointer-less host to start from.
ORCAD_ARTIFACT_DIR=/opt/orca/<artifact>-<version>-<buildsha>
